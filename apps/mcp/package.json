{
  "name": "@synapse/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && tsdown",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "inspector": "pnpm dlx -y @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@synapse/core": "workspace:*",
    "hono": "^4.12.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
